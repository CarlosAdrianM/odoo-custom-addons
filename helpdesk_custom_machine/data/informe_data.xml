<odoo noupdate="1">
    <record id="cron_informes_reparacion" model="ir.cron">
        <field name="name">Servicio técnico: redactar borradores de informes de reparación</field>
        <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket"/>
        <field name="state">code</field>
        <field name="code">model._cron_informes()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
